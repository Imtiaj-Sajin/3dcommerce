# ============================================================
#  METAMART - copy this to .env and fill in your own values.
#  .env is gitignored; this example file is safe to commit.
# ============================================================

NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# ---------- database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=metama_db

# ---------- auth ----------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES=12h

# ---------- AI providers ----------
# Fallback order, cheapest/fastest first. Unconfigured providers are skipped.
AI_PROVIDER_ORDER=groq,openai,gemini

GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=models/gemini-3.1-flash-lite-image

# ---------- guardrails ----------
AI_DAILY_BUDGET_USD=5
AI_MAX_INPUT_CHARS=8000
AI_RATE_PER_MIN=30
OPENAI_IMAGE_MODEL=gpt-image-1
